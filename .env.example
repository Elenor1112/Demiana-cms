# ─── Database (PostgreSQL) ───
# Neon:      postgresql://user:pass@ep-xxx.region.aws.neon.tech/elenor?sslmode=require
# Supabase:  postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
#
# IMPORTANT — connection poolers (any host containing "-pooler", PgBouncer,
# Supabase's :6543 port): append &pgbouncer=true. Without it Prisma reuses
# server-side prepared statements across pooled connections, and any column
# type change then fails every query with
#   "cached plan must not change result type"
# until the pool is recycled — writes silently 500 and edits appear not to save.
DATABASE_URL="postgresql://user:password@localhost:5432/elenor?schema=public"

# ─── Timezone ───
# The zone the business operates in. User-entered wall-clock times ("1:30 PM")
# are interpreted here, and all timestamps are DISPLAYED here, so the value is
# independent of where the server runs (Vercel runs UTC) or where an employee
# happens to be. Must be an IANA name; DST is handled automatically.
# Defaults to Africa/Cairo when unset.
NEXT_PUBLIC_APP_TIMEZONE="Africa/Cairo"

# ─── Auth ───
# Generate: openssl rand -base64 32
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
# How long a signed-in session lasts before the access token must be renewed.
# Accepts s/m/h/d — the access cookie's lifetime is derived from this value.
ACCESS_TOKEN_TTL="8h"
# How long a user can return without signing in again. Renewal is silent, so
# this is the value that decides "how often do I have to log in".
REFRESH_TOKEN_TTL_DAYS="30"

# ─── App ───
NEXT_PUBLIC_APP_NAME="Elenor OS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Web Push (VAPID) ───
# Required for browser push notifications. Generate a fresh pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is sent to the browser (safe to expose); the private key is NOT.
# Rotating these invalidates every existing subscription — users must re-enable.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@elenor.com"

# ─── Storage (Cloudflare R2 / S3) — future ───
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
