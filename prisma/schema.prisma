// Elenor Marketing Agency — Internal Operations Platform
// Full data model (ERD). PostgreSQL in production; set DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// IDENTITY, ORG & RBAC
// ─────────────────────────────────────────────────────────────

enum RoleKey {
  CEO
  OPERATIONS_MANAGER
  ACCOUNT_MANAGER
  SALES_MANAGER
  ART_DIRECTOR
  DESIGNER
  CONTENT_CREATOR
  COMMUNICATION_SPECIALIST
  DEVELOPER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  OFFBOARDING
  DEACTIVATED
}

model Role {
  id           String           @id @default(cuid())
  key          RoleKey          @unique
  name         String
  description  String?
  level        Int              @default(0) // 0 = highest (CEO). Used for approval routing/hierarchy.
  isSuperAdmin Boolean          @default(false)
  permissions  RolePermission[]
  users        User[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. "Task.Create"
  group       String // e.g. "Task"
  description String?
  roles       RolePermission[]
  grants      UserPermission[]
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String

  @@id([roleId, permissionId])
}

// Per-user permission overrides (grant or revoke on top of role)
model UserPermission {
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String
  effect       GrantEffect @default(ALLOW)

  @@id([userId, permissionId])
}

enum GrantEffect {
  ALLOW
  DENY
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String   @default("#06B6D4")
  archived    Boolean  @default(false)
  headId      String?
  head        User?    @relation("DepartmentHead", fields: [headId], references: [id])
  members     User[]   @relation("DepartmentMembers")
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  passwordHash       String
  passwordChangedAt  DateTime?
  mustChangePassword Boolean    @default(false)
  firstName          String
  lastName           String
  avatarUrl          String?
  phone              String?
  jobTitle           String?
  status             UserStatus @default(ACTIVE)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  departmentId String?
  department   Department?  @relation("DepartmentMembers", fields: [departmentId], references: [id])
  headOf       Department[] @relation("DepartmentHead")

  // Reporting line
  managerId String?
  manager   User?   @relation("ManagerReports", fields: [managerId], references: [id])
  reports   User[]  @relation("ManagerReports")

  hireDate           DateTime?
  birthDate          DateTime?
  annualLeaveBalance Int       @default(21)
  sickLeaveBalance   Int       @default(10)

  permissions UserPermission[]

  // Relations
  createdTasks    Task[]              @relation("TaskCreatedBy")
  assignedTasks   TaskAssignee[]
  taskFollows     TaskFollower[]
  comments        Comment[]
  activities      Activity[]
  projectsLed     Project[]           @relation("ProjectLead")
  projectMembers  ProjectMember[]
  leaveRequests   LeaveRequest[]      @relation("LeaveRequester")
  leaveActing     LeaveRequest[]      @relation("LeaveActing")
  approvalsMade   ApprovalStep[]      @relation("ApprovalApprover")
  permissionReqs  PermissionRequest[]
  resignations    Resignation[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]
  eotmScores      EotmScore[]
  eotmWins        EotmWinner[]
  warnings        Warning[]           @relation("WarnedUser")
  warningsIssued  Warning[]           @relation("WarnedBy")
  reviewsreceived PerformanceReview[] @relation("ReviewSubject")
  reviewsGiven    PerformanceReview[] @relation("ReviewAuthor")
  documents       EmployeeDocument[]
  achievements    Achievement[]
  attendances     Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([departmentId])
  @@index([managerId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// CLIENTS & PROJECTS
// ─────────────────────────────────────────────────────────────

enum ClientStatus {
  ACTIVE
  PROSPECT
  INACTIVE
  ARCHIVED
}

model Client {
  id            String       @id @default(cuid())
  company       String
  contactPerson String?
  email         String?
  phone         String?
  industry      String?
  status        ClientStatus @default(ACTIVE)
  notes         String?
  projects      Project[]
  tasks         Task[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  industry    String?

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  leadId String?
  lead   User?   @relation("ProjectLead", fields: [leadId], references: [id])

  startDate DateTime?
  deadline  DateTime?
  budget    Decimal?  @db.Decimal(12, 2)

  members   ProjectMember[]
  tasks     Task[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([clientId])
}

model ProjectMember {
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      String  @default("member")

  @@id([projectId, userId])
}

// ─────────────────────────────────────────────────────────────
// TASKS
// ─────────────────────────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  HOLD
  WAITING_APPROVAL
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

model Task {
  id          String       @id @default(cuid())
  code        String       @unique // e.g. ELN-142
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  industry String?

  createdById String
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  // Subtask tree
  parentId String?
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id])
  subtasks Task[]  @relation("Subtasks")

  assignees   TaskAssignee[]
  followers   TaskFollower[]
  labels      TaskLabel[]
  comments    Comment[]       @relation("TaskComments")
  activities  Activity[]      @relation("TaskActivities")
  attachments Attachment[]    @relation("TaskAttachments")
  checklist   ChecklistItem[]

  dependsOn  TaskDependency[] @relation("Dependent")
  dependedBy TaskDependency[] @relation("Prerequisite")

  deadline       DateTime?
  estimatedHours Float?
  actualHours    Float?
  progress       Int       @default(0) // 0-100

  approvalStatus ApprovalStatus @default(NOT_REQUIRED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([projectId])
  @@index([clientId])
  @@index([departmentId])
  @@index([createdById])
}

model TaskAssignee {
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@id([taskId, userId])
}

model TaskFollower {
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@id([taskId, userId])
}

model Label {
  id    String      @id @default(cuid())
  name  String      @unique
  color String      @default("#06B6D4")
  tasks TaskLabel[]
}

model TaskLabel {
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId  String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)
  labelId String

  @@id([taskId, labelId])
}

model TaskDependency {
  // dependent depends on prerequisite
  dependent      Task   @relation("Dependent", fields: [dependentId], references: [id], onDelete: Cascade)
  dependentId    String
  prerequisite   Task   @relation("Prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  prerequisiteId String

  @@id([dependentId, prerequisiteId])
}

model ChecklistItem {
  id     String  @id @default(cuid())
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
  text   String
  done   Boolean @default(false)
  order  Int     @default(0)
}

model Attachment {
  id        String   @id @default(cuid())
  name      String
  url       String
  size      Int?
  mimeType  String?
  task      Task?    @relation("TaskAttachments", fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String?
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  task      Task?    @relation("TaskComments", fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String?
  mentions  String[] // userIds mentioned
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

// ─────────────────────────────────────────────────────────────
// ACTIVITY / AUDIT
// ─────────────────────────────────────────────────────────────

model Activity {
  id        String   @id @default(cuid())
  actor     User     @relation(fields: [actorId], references: [id])
  actorId   String
  verb      String // "created", "moved", "assigned"...
  entity    String // "task", "project"...
  entityId  String
  meta      Json?
  task      Task?    @relation("TaskActivities", fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     User?    @relation(fields: [actorId], references: [id])
  actorId   String?
  action    String // "user.delete"
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ip        String?
  device    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
}

// ─────────────────────────────────────────────────────────────
// APPROVALS (generic multi-step engine)
// ─────────────────────────────────────────────────────────────

enum ApprovalKind {
  LEAVE
  PERMISSION
  RESIGNATION
  CONTENT
  DESIGN
}

enum StepDecision {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

model ApprovalStep {
  id         String       @id @default(cuid())
  kind       ApprovalKind
  entityId   String // id of the leave/permission/etc.
  order      Int
  roleKey    RoleKey? // who should approve (by role)
  approver   User?        @relation("ApprovalApprover", fields: [approverId], references: [id])
  approverId String?
  decision   StepDecision @default(PENDING)
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime     @default(now())

  @@index([kind, entityId])
}

// ─────────────────────────────────────────────────────────────
// LEAVE
// ─────────────────────────────────────────────────────────────

enum LeaveType {
  ANNUAL
  SICK
  EMERGENCY
  PERSONAL
  UNPAID
  OTHER
}

enum RequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id              String        @id @default(cuid())
  requester       User          @relation("LeaveRequester", fields: [requesterId], references: [id])
  requesterId     String
  type            LeaveType
  startDate       DateTime
  endDate         DateTime
  days            Int
  returnDate      DateTime?
  reason          String
  actingUser      User?         @relation("LeaveActing", fields: [actingUserId], references: [id])
  actingUserId    String?
  handover        String?
  declaration     Boolean       @default(false)
  status          RequestStatus @default(PENDING)
  rejectionReason String?
  rejectedById    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([requesterId])
  @@index([status])
}

enum PermissionRequestType {
  LATE_ARRIVAL
  EARLY_LEAVE
  TEMPORARY_LEAVE
  MEDICAL_APPOINTMENT
  EMERGENCY
  OTHER
}

model PermissionRequest {
  id              String                @id @default(cuid())
  requester       User                  @relation(fields: [requesterId], references: [id])
  requesterId     String
  type            PermissionRequestType
  date            DateTime
  fromTime        String?
  toTime          String?
  reason          String
  status          RequestStatus         @default(PENDING)
  rejectionReason String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([requesterId])
}

// ─────────────────────────────────────────────────────────────
// RESIGNATION & OFFBOARDING
// ─────────────────────────────────────────────────────────────

model Resignation {
  id             String            @id @default(cuid())
  employee       User              @relation(fields: [employeeId], references: [id])
  employeeId     String
  department     String?
  jobTitle       String?
  reason         String
  submissionDate DateTime          @default(now())
  lastWorkingDay DateTime
  status         RequestStatus     @default(PENDING)
  checklist      OffboardingItem[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model OffboardingItem {
  id            String      @id @default(cuid())
  resignation   Resignation @relation(fields: [resignationId], references: [id], onDelete: Cascade)
  resignationId String
  label         String
  category      String // "assets", "knowledge", "handover", "account", "exit"
  done          Boolean     @default(false)
}

// ─────────────────────────────────────────────────────────────
// PERFORMANCE, EOTM, DISCIPLINE, ATTENDANCE
// ─────────────────────────────────────────────────────────────

model Attendance {
  id       String    @id @default(cuid())
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  date     DateTime
  checkIn  DateTime?
  checkOut DateTime?
  late     Boolean   @default(false)
  status   String    @default("present") // present, absent, leave, remote

  @@unique([userId, date])
  @@index([userId])
}

model PerformanceReview {
  id           String   @id @default(cuid())
  subject      User     @relation("ReviewSubject", fields: [subjectId], references: [id])
  subjectId    String
  author       User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  authorId     String
  period       String // "2026-07"
  qualityScore Int // 0-100
  notes        String?
  createdAt    DateTime @default(now())

  @@index([subjectId])
}

enum WarningLevel {
  BLUE
  YELLOW
  RED
}

model Warning {
  id         String       @id @default(cuid())
  user       User         @relation("WarnedUser", fields: [userId], references: [id])
  userId     String
  issuedBy   User         @relation("WarnedBy", fields: [issuedById], references: [id])
  issuedById String
  level      WarningLevel
  reason     String
  createdAt  DateTime     @default(now())

  @@index([userId])
}

model EotmConfig {
  id                   String   @id @default(cuid())
  taskCompletionWeight Int      @default(30)
  deadlineWeight       Int      @default(20)
  qualityWeight        Int      @default(20)
  attendanceWeight     Int      @default(10)
  collaborationWeight  Int      @default(10)
  initiativeWeight     Int      @default(10)
  updatedAt            DateTime @default(now()) @updatedAt
}

model EotmScore {
  id             String @id @default(cuid())
  user           User   @relation(fields: [userId], references: [id])
  userId         String
  period         String // "2026-07"
  taskCompletion Float  @default(0)
  deadline       Float  @default(0)
  quality        Float  @default(0)
  attendance     Float  @default(0)
  collaboration  Float  @default(0)
  initiative     Float  @default(0)
  total          Float  @default(0)

  @@unique([userId, period])
  @@index([period])
}

model EotmWinner {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  period        String   @unique // one winner per month
  total         Float
  overridden    Boolean  @default(false)
  justification String?
  reward        String?
  createdAt     DateTime @default(now())
}

model Achievement {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  badge     String // key of badge
  title     String
  awardedAt DateTime @default(now())
}

model EmployeeDocument {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  url       String
  category  String   @default("general")
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────

enum NotificationType {
  TASK_ASSIGNED
  DEADLINE_REMINDER
  APPROVAL_REQUIRED
  LEAVE_APPROVED
  LEAVE_REJECTED
  PERMISSION_APPROVED
  COMMENT_ADDED
  MENTIONED
  PROJECT_UPDATED
  BIRTHDAY
  EOTM
  ANNOUNCEMENT
  WARNING
}

model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  meta      Json?
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

// ─────────────────────────────────────────────────────────────
// COMPANY POLICIES
// ─────────────────────────────────────────────────────────────

model Policy {
  id              String      @id @default(cuid())
  slug            String      @unique
  title           String
  category        String
  body            String // markdown
  version         Int         @default(1)
  order           Int         @default(0)
  requiresAck     Boolean     @default(false)
  acknowledgments PolicyAck[]
  updatedAt       DateTime    @default(now()) @updatedAt
}

model PolicyAck {
  id       String   @id @default(cuid())
  policy   Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  policyId String
  userId   String
  version  Int
  ackedAt  DateTime @default(now())

  @@unique([policyId, userId, version])
}
